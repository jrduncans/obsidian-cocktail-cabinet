{
	"name": "obsidian-cocktail-cabinet",
	"version": "0.1.1",
	"description": "Cocktail recipes and bottle inventory tools for your vault.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node scripts/test.mjs && node scripts/catalog-docs.mjs --check && node scripts/catalog-history.mjs --check",
		"catalog:docs": "node scripts/catalog-docs.mjs && node scripts/catalog-history.mjs",
		"install:vault": "node scripts/run-ts.mjs scripts/install-vault.ts",
		"install:dev": "node scripts/run-ts.mjs scripts/install-vault.ts --dev"
	},
	"keywords": [],
	"license": "0-BSD",
	"overrides": {
		"obsidian": {
			"moment": "2.31.0"
		}
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.20.5",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "^17.14.0",
		"jiti": "^2.6.1",
		"linkedom": "0.18.15",
		"obsidian": "1.12.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.73.0"
	},
	"dependencies": {
		"yaml": "^2.9.1"
	}
}
